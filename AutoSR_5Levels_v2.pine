//@version=5
// Auto S/R (5 Levels) v2
// -----------------------------------------------------------------------------
// Rewrite of "Auto S/R (5 Levels FINAL FIX)" addressing the accuracy issues in
// the original:
//   1. Levels are drawn as real horizontal rays (line.new, extend=right) anchored
//      at the true pivot bar — no more diagonal plot() connectors, and each line
//      tracks ONE fixed price for its whole life instead of sliding as an array
//      index.
//   2. Broken levels are invalidated: on a decisive close through a level it is
//      deleted, or (optionally) flipped to the opposite role (classic S/R theory).
//   3. The "distinct level" gap is ATR- or percent-based, so behaviour is
//      scale-invariant across instruments and timeframes (the original used an
//      absolute price distance).
//   4. Re-tested pivots near an existing level increment a touch count instead of
//      being silently discarded; weakest (fewest-touch) levels are pruned first.
//   5. The NEAREST level to price is emphasized, not the most recent one.
// Every confirmed pivot is kept: a swing high at/above price is resistance, one
// below price is an already-broken level (flipped to support, or skipped in
// Delete mode) — nothing is silently dropped the way the ph>close gate would.
// Note: pivots confirm rightBars bars after the swing forms (inherent, non-
// repainting lag). Lines are anchored back at the real pivot bar to reflect this.
// -----------------------------------------------------------------------------
indicator("Auto S/R (5 Levels) v2", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================ INPUTS ============================
grpP = "Pivots"
leftBars  = input.int(5, "Left Strength",  minval=1, group=grpP)
rightBars = input.int(5, "Right Strength", minval=1, group=grpP)

grpL = "Levels"
maxLevels = input.int(5, "Max levels per side", minval=1, maxval=50, group=grpL)

grpG = "Distinct-level gap"
gapMode = input.string("ATR", "Gap mode", options=["ATR", "Percent"], group=grpG, tooltip="How far apart two pivots must be to count as separate levels. ATR adapts to volatility, Percent scales with price. Both are scale-invariant across instruments, unlike a fixed price gap.")
atrLen  = input.int(14, "ATR length", minval=1, group=grpG)
atrMult = input.float(0.5, "ATR gap multiple", minval=0.0, step=0.1, group=grpG)
gapPct  = input.float(0.5, "Percent gap %", minval=0.0, step=0.1, group=grpG)

grpB = "Invalidation"
onBreak   = input.string("Delete", "When a level breaks", options=["Delete", "Flip role"], group=grpB, tooltip="Delete removes a broken level. Flip role turns broken resistance into support (and vice-versa).")
breakMult = input.float(0.1, "Break buffer (ATR mult)", minval=0.0, step=0.05, group=grpB, tooltip="Price must close beyond a level by this many ATRs before it counts as broken. Reduces noise.")

grpV = "Visuals"
resCol     = input.color(color.red,   "Resistance color", group=grpV)
supCol     = input.color(color.green, "Support color",    group=grpV)
showLabels = input.bool(true, "Show price / touch labels", group=grpV)
emphasize  = input.bool(true, "Emphasize nearest level",   group=grpV)

// ============================ TYPES / STATE ============================
type SR
    float price
    int   touches
    int   startBar
    line  ln
    label lbl

var array<SR> resArr = array.new<SR>()
var array<SR> supArr = array.new<SR>()

atr  = ta.atr(atrLen)
gap  = math.max(gapMode == "ATR" ? nz(atr) * atrMult : close * gapPct / 100.0, syminfo.mintick)
brk  = nz(atr) * breakMult
flip = onBreak == "Flip role"

// ============================ HELPERS ============================
makeLevel(float price, int startBar, color col) =>
    ln  = line.new(startBar, price, bar_index, price, extend=extend.right, color=col, width=1)
    lbl = label.new(bar_index, price, "", style=label.style_label_left, textcolor=col, color=color.new(col, 100), size=size.small)
    SR.new(price, 1, startBar, ln, lbl)

deleteLevel(SR s) =>
    line.delete(s.ln)
    label.delete(s.lbl)

// index of the closest existing level within gap g, or -1 if none
nearestWithin(array<SR> arr, float price, float g) =>
    idx  = -1
    best = g
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            d = math.abs(price - array.get(arr, i).price)
            if d <= best
                best := d
                idx  := i
    idx

// drop the weakest level (fewest touches, ties broken by age) to respect the cap
// (trailing `true` keeps the if a statement so the function has one return type)
removeWeakest(array<SR> arr) =>
    if array.size(arr) >= 2
        wi = 0
        ws = array.get(arr, 0)
        for i = 1 to array.size(arr) - 1
            s = array.get(arr, i)
            if s.touches < ws.touches or (s.touches == ws.touches and s.startBar < ws.startBar)
                ws := s
                wi := i
        deleteLevel(array.get(arr, wi))
        array.remove(arr, wi)
    true

// add a fresh level, or bump the touch count if a pivot re-tests an existing one
addOrTouch(array<SR> arr, float price, int startBar, color col) =>
    idx = nearestWithin(arr, price, gap)
    if idx >= 0
        s = array.get(arr, idx)
        s.touches := s.touches + 1
    else
        array.push(arr, makeLevel(price, startBar, col))
        if array.size(arr) > maxLevels
            removeWeakest(arr)
    true

// move a broken level to the opposite array, merging into an existing level there
flipOrMerge(SR s, array<SR> toArr, color col) =>
    idx = nearestWithin(toArr, s.price, gap)
    if idx >= 0
        existing = array.get(toArr, idx)
        existing.touches := existing.touches + 1
        deleteLevel(s)
    else
        line.set_color(s.ln, col)
        label.set_textcolor(s.lbl, col)
        s.touches  := 1
        s.startBar := bar_index          // treat as newly created for age tie-breaks
        array.push(toArr, s)
        if array.size(toArr) > maxLevels
            removeWeakest(toArr)
    true

// ============================ PIVOTS -> LEVELS ============================
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low,  leftBars, rightBars)
pivotBar = bar_index - rightBars

// Swing high: resistance if at/above price, else an already-broken level
if not na(ph)
    if ph >= close
        addOrTouch(resArr, ph, pivotBar, resCol)
    else if flip
        addOrTouch(supArr, ph, pivotBar, supCol)

// Swing low: support if at/below price, else an already-broken level
if not na(pl)
    if pl <= close
        addOrTouch(supArr, pl, pivotBar, supCol)
    else if flip
        addOrTouch(resArr, pl, pivotBar, resCol)

// ============================ INVALIDATION ============================
// Iterate top-down with a while loop (Pine rejects a negative `for ... by`
// step) so array.remove at the current index never shifts unvisited indices.

// Resistance broken when price closes above it (beyond the buffer)
ri = array.size(resArr) - 1
while ri >= 0
    s = array.get(resArr, ri)
    if close > s.price + brk
        array.remove(resArr, ri)
        if flip
            flipOrMerge(s, supArr, supCol)
        else
            deleteLevel(s)
    ri := ri - 1

// Support broken when price closes below it (beyond the buffer)
si = array.size(supArr) - 1
while si >= 0
    s = array.get(supArr, si)
    if close < s.price - brk
        array.remove(supArr, si)
        if flip
            flipOrMerge(s, resArr, resCol)
        else
            deleteLevel(s)
    si := si - 1

// ============================ REFRESH (labels + emphasis) ============================
// Only the last bar's state is displayed, so update drawing objects there.
refresh(array<SR> arr, bool isRes) =>
    n = array.size(arr)
    if n > 0
        ni = -1
        nd = 1e20
        if emphasize
            for i = 0 to n - 1
                d = math.abs(close - array.get(arr, i).price)
                if d < nd
                    nd := d
                    ni := i
        for i = 0 to n - 1
            s = array.get(arr, i)
            line.set_width(s.ln, emphasize and i == ni ? 2 : 1)
            label.set_x(s.lbl, bar_index)
            label.set_y(s.lbl, s.price)
            txt = (isRes ? "R " : "S ") + str.tostring(s.price, format.mintick) + (s.touches > 1 ? "  " + str.tostring(s.touches) + "x" : "")
            label.set_text(s.lbl, showLabels ? txt : "")
    true

if barstate.islast
    refresh(resArr, true)
    refresh(supArr, false)

// ============================ ENTRY / EXIT SIGNALS ============================
// Mechanical signals derived from the levels above. NOT financial advice — these
// are illustrative rules; backtest and manage risk before trading real money.
//   Bounce   : buy when price taps support and closes back up (target = nearest
//              resistance, stop = just below support); mirror for shorts.
//   Breakout : buy when price closes above a resistance (stop = just below the
//              broken level); mirror for shorts below support.
grpS = "Entry / Exit signals"
showSig  = input.bool(true,   "Show entry/exit signals", group=grpS)
sigMode  = input.string("Bounce", "Strategy", options=["Bounce", "Breakout"], group=grpS, tooltip="Bounce fades the level (mean reversion). Breakout trades the break of the level.")
touchTol = input.float(0.25,  "Bounce touch tolerance (ATR mult)", minval=0.0, step=0.05, group=grpS)

// nearest level strictly below / above the current price
nearestBelow(array<SR> arr, float price) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            p = array.get(arr, i).price
            if p < price and (na(best) or p > best)
                best := p
    best

nearestAbove(array<SR> arr, float price) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            p = array.get(arr, i).price
            if p > price and (na(best) or p < best)
                best := p
    best

supBelow = nearestBelow(supArr, close)
resAbove = nearestAbove(resArr, close)
tol = nz(atr) * touchTol

var bool  inLong  = false
var bool  inShort = false
var float stopP   = na       // active stop price
var float tgtP    = na       // active target price

buy   = false
sell  = false
exitL = false
exitS = false

if showSig
    // ---- entries (only when flat) ----
    if not inLong and not inShort
        if sigMode == "Bounce"
            if not na(supBelow) and low <= supBelow + tol and close >= open
                buy   := true
                stopP := supBelow - brk
                tgtP  := resAbove
            else if not na(resAbove) and high >= resAbove - tol and close <= open
                sell  := true
                stopP := resAbove + brk
                tgtP  := supBelow
        else
            if not na(resAbove[1]) and close > resAbove[1] and close[1] <= resAbove[1]
                buy   := true
                stopP := resAbove[1] - brk
                tgtP  := na
            else if not na(supBelow[1]) and close < supBelow[1] and close[1] >= supBelow[1]
                sell  := true
                stopP := supBelow[1] + brk
                tgtP  := na
    if buy
        inLong := true
    if sell
        inShort := true
    // ---- exits (target hit or stop closed through) ----
    if inLong and not buy
        if (not na(tgtP) and high >= tgtP) or (not na(stopP) and close < stopP)
            exitL  := true
            inLong := false
            stopP  := na
            tgtP   := na
    if inShort and not sell
        if (not na(tgtP) and low <= tgtP) or (not na(stopP) and close > stopP)
            exitS   := true
            inShort := false
            stopP   := na
            tgtP    := na

plotshape(showSig and buy,   title="Buy",        style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, text="BUY",  size=size.small)
plotshape(showSig and sell,  title="Sell",       style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),   textcolor=color.white, text="SELL", size=size.small)
plotshape(showSig and exitL, title="Exit long",  style=shape.xcross,    location=location.abovebar, color=color.gray, text="EXIT", size=size.tiny)
plotshape(showSig and exitS, title="Exit short", style=shape.xcross,    location=location.belowbar, color=color.gray, text="EXIT", size=size.tiny)

alertcondition(buy,   "S/R Buy",        "Auto S/R: long entry")
alertcondition(sell,  "S/R Sell",       "Auto S/R: short entry")
alertcondition(exitL, "S/R Exit long",  "Auto S/R: exit long")
alertcondition(exitS, "S/R Exit short", "Auto S/R: exit short")

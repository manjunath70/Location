//@version=5
// Auto S/R (5 Levels) v2
// -----------------------------------------------------------------------------
// Keeps a rolling pool of distinct swing pivots. On every bar it shows the N
// nearest levels ABOVE price as resistance and the N nearest BELOW price as
// support (default 5 each), so you always see up to N of each side. Levels are
// real horizontal rays; a level's role flips automatically as price crosses it
// (broken resistance becomes support, and vice-versa). The distinct-level gap is
// ATR/percent based, so spacing is scale-invariant across instruments.
// Note: pivots confirm rightBars bars after the swing forms (inherent, non-
// repainting lag). Lines are anchored back at the real pivot bar.
// -----------------------------------------------------------------------------
indicator("Auto S/R (5 Levels) v2", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================ INPUTS ============================
grpP = "Pivots"
leftBars  = input.int(5, "Left Strength",  minval=1, group=grpP)
rightBars = input.int(5, "Right Strength", minval=1, group=grpP)

grpL = "Levels"
maxLevels = input.int(5, "Levels shown per side", minval=1, maxval=20, group=grpL)

grpG = "Distinct-level gap"
gapMode = input.string("ATR", "Gap mode", options=["ATR", "Percent"], group=grpG, tooltip="Minimum spacing between distinct levels. ATR adapts to volatility, Percent scales with price.")
atrLen  = input.int(14, "ATR length", minval=1, group=grpG)
atrMult = input.float(0.5, "ATR gap multiple", minval=0.0, step=0.1, group=grpG)
gapPct  = input.float(0.5, "Percent gap %", minval=0.0, step=0.1, group=grpG)

grpV = "Visuals"
resCol     = input.color(color.red,   "Resistance color", group=grpV)
supCol     = input.color(color.green, "Support color",    group=grpV)
showLabels = input.bool(true, "Show price / touch labels", group=grpV)
emphasize  = input.bool(true, "Emphasize nearest level",   group=grpV)

// ============================ STATE ============================
type SR
    float price
    int   touches
    int   startBar
    line  ln
    label lbl

var array<SR> pool = array.new<SR>()

atr     = ta.atr(atrLen)
gap     = math.max(gapMode == "ATR" ? nz(atr) * atrMult : close * gapPct / 100.0, syminfo.mintick)
poolMax = math.max(maxLevels * 6, 30)

// ============================ HELPERS ============================
makeLevel(float price, int startBar) =>
    ln  = line.new(startBar, price, bar_index, price, extend=extend.right, color=supCol, width=1)
    lbl = label.new(bar_index, price, "", style=label.style_label_left, size=size.small, color=color.new(color.gray, 100))
    SR.new(price, 1, startBar, ln, lbl)

deleteLevel(SR s) =>
    line.delete(s.ln)
    label.delete(s.lbl)

// index of the closest existing level within gap g, or -1 if none
nearestWithin(array<SR> arr, float price, float g) =>
    idx  = -1
    best = g
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            d = math.abs(price - array.get(arr, i).price)
            if d <= best
                best := d
                idx  := i
    idx

// drop the weakest level (fewest touches, ties broken by age) to respect the cap
removeWeakest(array<SR> arr) =>
    if array.size(arr) >= 2
        wi = 0
        ws = array.get(arr, 0)
        for i = 1 to array.size(arr) - 1
            s = array.get(arr, i)
            if s.touches < ws.touches or (s.touches == ws.touches and s.startBar < ws.startBar)
                ws := s
                wi := i
        deleteLevel(array.get(arr, wi))
        array.remove(arr, wi)
    true

// add a fresh level, or bump the touch count if a pivot re-tests an existing one
addOrTouch(array<SR> arr, float price, int startBar) =>
    idx = nearestWithin(arr, price, gap)
    if idx >= 0
        s = array.get(arr, idx)
        s.touches := s.touches + 1
    else
        array.push(arr, makeLevel(price, startBar))
        if array.size(arr) > poolMax
            removeWeakest(arr)
    true

// nearest pooled level strictly below / above a price (na if none)
nearBelow(array<SR> arr, float price) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            p = array.get(arr, i).price
            if p < price and (na(best) or p > best)
                best := p
    best

nearAbove(array<SR> arr, float price) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            p = array.get(arr, i).price
            if p > price and (na(best) or p < best)
                best := p
    best

// ============================ COLLECT PIVOTS ============================
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low,  leftBars, rightBars)
pivotBar = bar_index - rightBars

if not na(ph)
    addOrTouch(pool, ph, pivotBar)
if not na(pl)
    addOrTouch(pool, pl, pivotBar)

// ============================ DISPLAY (nearest N each side) ============================
// For each pooled level, count how many same-side (above/below price) levels are
// closer; the closest `maxLevels` per side are shown, the rest hidden.
drawLevels(array<SR> arr) =>
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            s = array.get(arr, i)
            isRes = s.price > close
            dThis = math.abs(s.price - close)
            rank  = 0
            for j = 0 to n - 1
                if j != i
                    o = array.get(arr, j)
                    if (o.price > close) == isRes
                        dOther = math.abs(o.price - close)
                        if dOther < dThis or (dOther == dThis and j < i)
                            rank := rank + 1
            col = isRes ? resCol : supCol
            if rank < maxLevels
                line.set_color(s.ln, col)
                line.set_width(s.ln, emphasize and rank == 0 ? 2 : 1)
                label.set_x(s.lbl, bar_index)
                label.set_y(s.lbl, s.price)
                label.set_textcolor(s.lbl, col)
                txt = (isRes ? "R " : "S ") + str.tostring(s.price, format.mintick) + (s.touches > 1 ? "  " + str.tostring(s.touches) + "x" : "")
                label.set_text(s.lbl, showLabels ? txt : "")
            else
                line.set_color(s.ln, color.new(col, 100))
                label.set_text(s.lbl, "")
    true

if barstate.islast
    drawLevels(pool)

// ============================ ENTRY / EXIT SIGNALS ============================
// Mechanical signals derived from the levels above. NOT financial advice — these
// are illustrative rules; backtest and manage risk before trading real money.
//   Bounce   : buy when price taps support and closes back up (target = nearest
//              resistance, stop = just below support); mirror for shorts.
//   Breakout : buy when price closes above a resistance (stop = just below the
//              broken level); mirror for shorts below support.
grpS = "Entry / Exit signals"
showSig  = input.bool(true,   "Show entry/exit signals", group=grpS)
sigMode  = input.string("Bounce", "Strategy", options=["Bounce", "Breakout"], group=grpS, tooltip="Bounce fades the level (mean reversion). Breakout trades the break of the level.")
touchTol = input.float(0.25,  "Bounce touch tolerance (ATR mult)", minval=0.0, step=0.05, group=grpS)
stopMult = input.float(0.10,  "Stop buffer (ATR mult)", minval=0.0, step=0.05, group=grpS)

// ---- options adaptation ----
grpO = "Options"
strikeStep = input.float(1.0, "Strike increment", minval=0.0, step=0.5, group=grpO, tooltip="Your instrument's strike spacing, used to round to the nearest tradable strike. e.g. 50 for NIFTY, 100 for BANKNIFTY, 5 for many US stocks. Set 0 to show the raw price.")
strikeBias = input.string("ATM", "Strike selection", options=["ATM", "ITM", "OTM"], group=grpO, tooltip="ATM = nearest strike to price. ITM = one step in-the-money (safer, pricier). OTM = one step out-of-the-money (cheaper, higher risk).")
showDash   = input.bool(true, "Show options dashboard", group=grpO)

brk = nz(atr) * stopMult
supBelow = nearBelow(pool, close)
resAbove = nearAbove(pool, close)
tol = nz(atr) * touchTol

// nearest tradable strike, then apply ITM/OTM bias per direction
roundStrike(float price) =>
    strikeStep > 0 ? math.round(price / strikeStep) * strikeStep : price

atmStrike  = roundStrike(close)
callStrike = atmStrike + (strikeBias == "ITM" ? -strikeStep : strikeBias == "OTM" ? strikeStep : 0.0)
putStrike  = atmStrike + (strikeBias == "ITM" ? strikeStep : strikeBias == "OTM" ? -strikeStep : 0.0)

var bool  inLong  = false
var bool  inShort = false
var float stopP   = na       // active stop price
var float tgtP    = na       // active target price

buy   = false
sell  = false
exitL = false
exitS = false

if showSig
    // ---- entries (only when flat) ----
    if not inLong and not inShort
        if sigMode == "Bounce"
            if not na(supBelow) and low <= supBelow + tol and close >= open
                buy   := true
                stopP := supBelow - brk
                tgtP  := resAbove
            else if not na(resAbove) and high >= resAbove - tol and close <= open
                sell  := true
                stopP := resAbove + brk
                tgtP  := supBelow
        else
            if not na(resAbove[1]) and close > resAbove[1] and close[1] <= resAbove[1]
                buy   := true
                stopP := resAbove[1] - brk
                tgtP  := na
            else if not na(supBelow[1]) and close < supBelow[1] and close[1] >= supBelow[1]
                sell  := true
                stopP := supBelow[1] + brk
                tgtP  := na
    if buy
        inLong := true
    if sell
        inShort := true
    // ---- exits (target hit or stop closed through) ----
    if inLong and not buy
        if (not na(tgtP) and high >= tgtP) or (not na(stopP) and close < stopP)
            exitL  := true
            inLong := false
            stopP  := na
            tgtP   := na
    if inShort and not sell
        if (not na(tgtP) and low <= tgtP) or (not na(stopP) and close > stopP)
            exitS   := true
            inShort := false
            stopP   := na
            tgtP    := na

plotshape(showSig and buy,   title="Call",       style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, text="CALL",  size=size.small)
plotshape(showSig and sell,  title="Put",        style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),   textcolor=color.white, text="PUT",   size=size.small)
plotshape(showSig and exitL, title="Close call", style=shape.xcross,    location=location.abovebar, color=color.gray, text="CLOSE", size=size.tiny)
plotshape(showSig and exitS, title="Close put",  style=shape.xcross,    location=location.belowbar, color=color.gray, text="CLOSE", size=size.tiny)

alertcondition(buy,   "S/R Call (bullish)", "Auto S/R: buy CALL")
alertcondition(sell,  "S/R Put (bearish)",  "Auto S/R: buy PUT")
alertcondition(exitL, "S/R Close call",     "Auto S/R: close CALL")
alertcondition(exitS, "S/R Close put",      "Auto S/R: close PUT")

// ============================ OPTIONS DASHBOARD ============================
// Current actionable options plan (drawn top-right on the last bar). Direction,
// strike, target and stop only — premium/IV/Greeks are not available in Pine.
fmt(float x) => na(x) ? "-" : str.tostring(x, format.mintick)

var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 15), border_color=color.new(color.gray, 60), border_width=1)

if showDash and barstate.islast
    pos = inLong ? "In CALL" : inShort ? "In PUT" : "Flat"
    table.cell(dash, 0, 0, "Auto S/R — Options", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 0))
    table.cell(dash, 1, 0, sigMode,               text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 0))
    table.cell(dash, 0, 1, "Price",       text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, fmt(close),    text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 2, "Resistance",  text_color=resCol, text_size=size.small)
    table.cell(dash, 1, 2, fmt(resAbove), text_color=resCol, text_size=size.small)
    table.cell(dash, 0, 3, "Support",     text_color=supCol, text_size=size.small)
    table.cell(dash, 1, 3, fmt(supBelow), text_color=supCol, text_size=size.small)
    table.cell(dash, 0, 4, "CALL strike (" + strikeBias + ")", text_color=color.lime, text_size=size.small)
    table.cell(dash, 1, 4, fmt(callStrike),                    text_color=color.lime, text_size=size.small)
    table.cell(dash, 0, 5, "PUT strike (" + strikeBias + ")",  text_color=color.orange, text_size=size.small)
    table.cell(dash, 1, 5, fmt(putStrike),                     text_color=color.orange, text_size=size.small)
    table.cell(dash, 0, 6, "Position",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, pos,         text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 7, "Target / Stop", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, fmt(tgtP) + " / " + fmt(stopP), text_color=color.white, text_size=size.small)
